# Domínio usado pelo hostname público do Ollama.
PROCELBOT_DOMAIN=ollama.procel-chatbot.com

# Deve ser exatamente igual à API_KEY em deploy/backend/secrets/backend.env.
# Nunca preencha com ADMIN_API_KEY e nunca versione o valor real.
PROCELBOT_API_KEY=

# Usado somente pelo Caddy no hostname protegido do painel.
# Deve repetir ADMIN_API_KEY do backend; nunca vai para o navegador.
PROCELBOT_ADMIN_API_KEY=

# O hash Basic Auth fica separado em:
# secrets/proxy-basic-auth.hash
