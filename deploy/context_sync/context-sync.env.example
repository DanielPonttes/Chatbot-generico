# Instale como /etc/procelbot/context-sync.env, root:procelbot-context, modo 0640.
# Este é o único arquivo que recebe a credencial PostgreSQL existente.
# Sem TLS no servidor, a origem deve ser o endpoint local de um túnel SSH/VPN.
# O sincronizador recusa sslmode=disable para qualquer host não-loopback.
REMOTE_PG_HOST=127.0.0.1
REMOTE_PG_PORT=5433
REMOTE_PG_USER=
REMOTE_PG_PASSWORD=
REMOTE_PG_DATABASE=procel-analitical-db
REMOTE_PG_SSLMODE=disable
REMOTE_PG_CONNECT_TIMEOUT=5
CONTEXT_MAX_ITEMS=100
