# ====================================
# CONFIGURAÇÃO DO CHATBOT ECONÔMICO
# ====================================

# ------------------------------------
# PROVIDER LLM (ollama, huggingface, ou google)
# ------------------------------------
LLM_PROVIDER=google

# ------------------------------------
# CONFIGURAÇÃO GOOGLE GEMINI
# ------------------------------------
# API Key do Google Gemini (Obrigatório)
GEMINI_API_KEY=
# Modelo Gemini (padrão: gemini-1.5-flash)
GEMINI_MODEL=gemini-3-flash-preview

# ------------------------------------
# CONFIGURAÇÃO OLLAMA(FALLBACK)
# ------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

# ------------------------------------
# CONFIGURAÇÃO HUGGINGFACE
# ------------------------------------
HF_TOKEN=


# ------------------------------------
# CONFIGURAÇÃO DO BOT
# ------------------------------------
BOT_SYSTEM_PROMPT=Você é um assistente virtual amigável e prestativo. Responda sempre em português brasileiro de forma clara e objetiva.

# ------------------------------------
# CONFIGURAÇÃO DE MEMÓRIA
# ------------------------------------
MEMORY_MAX_MESSAGES=10
USE_SQLITE=false
SQLITE_PATH=./data/conversations.db

# ------------------------------------
# INTEGRAÇÕES EXTERNAS - POSTGRESQL REMOTO
# ------------------------------------
REMOTE_PG_HOST=srv1428963.hstgr.cloud
REMOTE_PG_PORT=5432
REMOTE_PG_USER=postgres
REMOTE_PG_PASSWORD=

REMOTE_PG_SSLMODE=prefer
REMOTE_PG_CONNECT_TIMEOUT=5
REMOTE_PG_MAX_LIMIT=100

# ------------------------------------
# INTEGRAÇÕES EXTERNAS - SPRING BOOT
# ------------------------------------
REMOTE_SPRING_BASE_URL=http://srv1428963.hstgr.cloud:8080
REMOTE_SPRING_TIMEOUT_SECONDS=15
