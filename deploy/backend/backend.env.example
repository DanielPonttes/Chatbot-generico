# Copie para secrets/backend.env no servidor e preencha as chaves reais.
# Este arquivo é apenas um modelo; não coloque valores reais no Git.

ENVIRONMENT=production
DEBUG=false
APP_NAME=Procel Chatbot

# Autenticação pública e administrativa da API.
API_KEY=
ADMIN_API_KEY=

# Inferência local no mesmo host Docker da RTX 5090.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_USERNAME=
OLLAMA_PASSWORD=
OLLAMA_MODEL=gemma4:26b

# Controles obrigatórios para publicação atrás do Caddy.
CORS_ALLOW_ORIGINS=https://procel-chatbot.com,https://www.procel-chatbot.com
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BODY_BYTES=2097152
ALLOWED_HOSTS=api.procel-chatbot.com,localhost,127.0.0.1,chatbot
TRUSTED_PROXY_NETWORKS=172.24.0.0/16
DOCS_PUBLIC=false
LEGACY_ROUTES_ENABLED=false
ALLOW_MODEL_OVERRIDE=false
ALLOWED_MODELS=gemma4:26b

# Persistência local do backend.
USE_SQLITE=true
SQLITE_PATH=/app/data/conversations.db
SQLITE_DB_PATH=/app/data/db/saved_notifications.db

# Integrações externas são opcionais nesta primeira subida.
REMOTE_PG_PASSWORD=
REMOTE_SPRING_USERNAME=
REMOTE_SPRING_PASSWORD=
