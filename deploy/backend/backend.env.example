# Copie para secrets/backend.env no servidor e preencha as chaves reais.
# Este arquivo é apenas um modelo; não coloque valores reais no Git.

ENVIRONMENT=production
DEBUG=false
APP_NAME=Procel Chatbot

# Autenticação pública e administrativa da API.
API_KEY=
ADMIN_API_KEY=

# Inferência local no mesmo host Docker da RTX 5090.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_USERNAME=
OLLAMA_PASSWORD=
OLLAMA_MODEL=gemma4:26b

# Controles obrigatórios para publicação atrás do Caddy.
CORS_ALLOW_ORIGINS=https://procel-chatbot.com,https://www.procel-chatbot.com
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BODY_BYTES=2097152
ALLOWED_HOSTS=api.procel-chatbot.com,localhost,127.0.0.1,chatbot
TRUSTED_PROXY_NETWORKS=172.24.0.0/16
DOCS_PUBLIC=false
LEGACY_ROUTES_ENABLED=false
ALLOW_MODEL_OVERRIDE=false
ALLOWED_MODELS=gemma4:26b

# Snapshot somente leitura do agente local do host.
NODE_METRICS_PATH=/run/procelbot/node-metrics/latest.json
NODE_METRICS_MAX_AGE_SECONDS=60

# Persistência local do backend.
USE_SQLITE=true
SQLITE_PATH=/app/data/conversations.db
SQLITE_DB_PATH=/app/data/db/saved_notifications.db

# Integrações externas são opcionais nesta primeira subida. Em produção,
# preencha somente com um papel PostgreSQL read-only e use TLS/túnel privado.
REMOTE_PG_HOST=
REMOTE_PG_PORT=5432
REMOTE_PG_USER=
REMOTE_PG_PASSWORD=
REMOTE_PG_DATABASE=
REMOTE_PG_SSLMODE=require
REMOTE_PG_CONNECT_TIMEOUT=5
REMOTE_PG_MAX_LIMIT=100
CONTEXT_MAX_AGE_SECONDS=300
CONTEXT_MAX_ITEMS=100

# A API Spring permanece opcional enquanto a origem HTTP não for validada.
REMOTE_SPRING_BASE_URL=
REMOTE_SPRING_TIMEOUT_SECONDS=15
REMOTE_SPRING_USERNAME=
REMOTE_SPRING_PASSWORD=
