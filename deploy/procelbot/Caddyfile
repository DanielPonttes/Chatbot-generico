{
    admin off
}

# Este stack expõe somente o Ollama. O backend FastAPI possui seu próprio
# gateway/contrato e não deve ser apontado para este upstream.
http://{$PROCELBOT_DOMAIN} {
    encode zstd gzip

    request_body {
        max_size 2MB
    }

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Cache-Control "no-store"
    }

    @unsafe_methods method TRACE CONNECT
    respond @unsafe_methods 405

    basic_auth {
        procelbot {$PROCELBOT_BASIC_AUTH_HASH}
    }

    @model_admin path /api/pull* /api/push* /api/delete* /api/copy* /api/create* /api/blobs/* /api/show* /api/ps*
    respond @model_admin 403

    reverse_proxy ollama:11434

    log {
        output stdout
        format json
    }
}

# API pública do chatbot. O FastAPI permanece sem porta publicada no host e
# recebe tráfego somente pela rede Docker interna.
http://api.procel-chatbot.com {
    encode zstd gzip

    request_body {
        max_size 2MB
    }

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Cache-Control "no-store"
    }

    @unsafe_methods method TRACE CONNECT
    respond @unsafe_methods 405

    # Swagger/ReDoc exigem uma segunda camada de acesso. O header da API é
    # injetado apenas nessa rota para a UI conseguir carregar o OpenAPI.
    @docs path /docs* /redoc*
    handle @docs {
        basic_auth {
            procelbot {$PROCELBOT_BASIC_AUTH_HASH}
        }
        reverse_proxy chatbot:8000 {
            header_up X-API-Key {$PROCELBOT_API_KEY}
        }
    }

    handle {
        reverse_proxy chatbot:8000
    }

    log {
        output stdout
        format json
    }
}

# Painel administrativo. O hostname será protegido por Cloudflare Access.
# O Caddy faz o proxy server-side e injeta as chaves somente no upstream;
# nenhuma chave chega ao HTML ou ao navegador.
http://admin.procel-chatbot.com {
    encode zstd gzip

    request_body {
        max_size 2MB
    }

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Cache-Control "no-store"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
    }

    @unsafe_methods method TRACE CONNECT
    respond @unsafe_methods 405

    # O cloudflared valida criptograficamente este JWT antes de encaminhar a
    # requisição. O bloqueio adicional evita servir o painel se o hostname
    # administrativo for apontado para este Caddy sem a proteção do Access.
    @admin_without_access not header Cf-Access-Jwt-Assertion *
    # A rota força a ordem: o bloqueio de Access ocorre antes de qualquer
    # handle que injete uma chave no upstream.
    route {
        respond @admin_without_access 403

        @admin_status {
            method GET
            path /api/status
        }
        handle @admin_status {
            rewrite * /v1/admin/status
            reverse_proxy chatbot:8000 {
                header_up -Cookie
                header_up -Authorization
                header_up -Cf-Access-Jwt-Assertion
                header_up Host api.procel-chatbot.com
                header_up X-API-Key {$PROCELBOT_ADMIN_API_KEY}
            }
        }

        # Notification Studio: catálogo, geração manual e revisão ficam atrás
        # do Access. A chave administrativa é injetada apenas no upstream e a
        # allowlist não expõe chat genérico, integrações ou contexto canônico.
        @notification_catalog {
            method GET
            path /v1/personas /v1/target-profiles /v1/notifications/missions /v1/notifications/types /v1/notifications/saved
        }
        handle @notification_catalog {
            reverse_proxy chatbot:8000 {
                header_up -Cookie
                header_up -Authorization
                header_up -Cf-Access-Jwt-Assertion
                header_up Host api.procel-chatbot.com
                header_up X-API-Key {$PROCELBOT_ADMIN_API_KEY}
            }
        }

        @notification_generate {
            method POST
            path /v1/notifications/generate
        }
        handle @notification_generate {
            reverse_proxy chatbot:8000 {
                header_up -Cookie
                header_up -Authorization
                header_up -Cf-Access-Jwt-Assertion
                header_up Host api.procel-chatbot.com
                header_up X-API-Key {$PROCELBOT_ADMIN_API_KEY}
            }
        }

        @notification_review {
            method PATCH
            path /v1/notifications/saved/*
        }
        handle @notification_review {
            reverse_proxy chatbot:8000 {
                header_up -Cookie
                header_up -Authorization
                header_up -Cf-Access-Jwt-Assertion
                header_up Host api.procel-chatbot.com
                header_up X-API-Key {$PROCELBOT_ADMIN_API_KEY}
            }
        }

        @notification_studio {
            method GET HEAD
            path /notifications
        }
        handle @notification_studio {
            rewrite * /notifications.html
            root * /srv/admin
            file_server
        }

        @notification_docs {
            method GET HEAD
            path /notifications/docs
        }
        handle @notification_docs {
            rewrite * /notifications-docs.html
            root * /srv/admin
            file_server
        }

        @admin_openapi {
            method GET
            path /openapi.json
        }
        handle @admin_openapi {
            reverse_proxy chatbot:8000 {
                header_up -Cookie
                header_up -Authorization
                header_up -Cf-Access-Jwt-Assertion
                header_up Host api.procel-chatbot.com
                header_up X-API-Key {$PROCELBOT_API_KEY}
            }
        }

        @admin_swagger {
            method GET
            path /swagger
        }
        handle @admin_swagger {
            rewrite * /docs
            reverse_proxy chatbot:8000 {
                header_up -Cookie
                header_up -Authorization
                header_up -Cf-Access-Jwt-Assertion
                header_up Host api.procel-chatbot.com
                header_up X-API-Key {$PROCELBOT_API_KEY}
            }
        }

        root * /srv/admin
        file_server
        respond 404
    }
}
