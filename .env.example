# ====================================

# CONFIGURAÇÃO DO CHATBOT ECONÔMICO

# ====================================



# ------------------------------------

# PROVIDER LLM (ollama, huggingface, ou google)

# ------------------------------------

LLM_PROVIDER=google



# ------------------------------------

# CONFIGURAÇÃO GOOGLE GEMINI

# ------------------------------------

# API Key do Google Gemini (Obrigatório)

GEMINI_API_KEY=
# Modelo Gemini (padrão: gemini-1.5-flash)

GEMINI_MODEL=gemini-3-flash-preview



# ------------------------------------

# CONFIGURAÇÃO OLLAMA(FALLBACK)

# ------------------------------------

OLLAMA_BASE_URL=http://localhost:11434

# Preencha somente quando OLLAMA_BASE_URL apontar para um gateway protegido.
# Nunca exponha estas credenciais no frontend ou em logs.
OLLAMA_USERNAME=
OLLAMA_PASSWORD=

# Modelo Ollama local aprovado para o agente: Gemma 4 26B A4B.
# Alternativa com menor uso de VRAM: gemma4:26b-a4b-it-qat
OLLAMA_MODEL=gemma4:26b


# ------------------------------------

# CONFIGURAÇÃO HUGGINGFACE

# ------------------------------------

HF_TOKEN=




# ------------------------------------

# CONFIGURAÇÃO DO BOT

# ------------------------------------

BOT_SYSTEM_PROMPT=Você é um assistente virtual amigável e prestativo. Responda sempre em português brasileiro de forma clara e objetiva.



# ------------------------------------

# CONFIGURAÇÃO DE MEMÓRIA

# ------------------------------------

MEMORY_MAX_MESSAGES=10

USE_SQLITE=false

SQLITE_PATH=./data/conversations.db



# ------------------------------------

# INTEGRAÇÕES EXTERNAS - POSTGRESQL REMOTO

# ------------------------------------

REMOTE_PG_HOST=srv1428963.hstgr.cloud

REMOTE_PG_PORT=5432

REMOTE_PG_USER=postgres

REMOTE_PG_PASSWORD=


REMOTE_PG_SSLMODE=prefer

REMOTE_PG_CONNECT_TIMEOUT=5

REMOTE_PG_MAX_LIMIT=100



# ------------------------------------

# INTEGRAÇÕES EXTERNAS - SPRING BOOT

# ------------------------------------

REMOTE_SPRING_BASE_URL=https://procel.servehttp.com

# Credenciais de login da API Spring (POST /api/auth/login retorna JWT)
REMOTE_SPRING_USERNAME=
REMOTE_SPRING_PASSWORD=

REMOTE_SPRING_TIMEOUT_SECONDS=15



# ------------------------------------
# API PÚBLICA
# ------------------------------------
# Ambiente. Em production a aplicação falha ao iniciar se os controles abaixo
# não estiverem configurados de forma segura.
ENVIRONMENT=development

# Chave de acesso da API (header X-API-Key). Nunca commite o valor real.
API_KEY=

# Chave separada para revisão/remoção de notificações e invocações Spring.
ADMIN_API_KEY=

# Origens CORS separadas por vírgula ("*" somente em desenvolvimento)
CORS_ALLOW_ORIGINS=*

# Limite de requisições por minuto por IP (0 = desativado)
RATE_LIMIT_PER_MINUTE=0

# Tamanho máximo do corpo HTTP aceito pelo backend (2 MiB)
MAX_REQUEST_BODY_BYTES=2097152

# Hostnames aceitos pelo app.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# IPs/redes que podem enviar X-Forwarded-For e X-Forwarded-Proto.
# Se o app estiver atrás de Caddy em Docker, informe a rede privada do proxy.
TRUSTED_PROXY_NETWORKS=127.0.0.1,::1

# Swagger/ReDoc públicos somente no desenvolvimento. Em produção, use false
# e disponibilize a documentação apenas pela rede administrativa/borda segura.
DOCS_PUBLIC=true

# Migração e seleção de modelo
LEGACY_ROUTES_ENABLED=true
ALLOW_MODEL_OVERRIDE=true
ALLOWED_MODELS=
